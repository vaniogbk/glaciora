{
  "name": "@glaciora/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts --ext .ts",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:catalogue": "tsx scripts/import-catalogue.ts",
    "emails:process": "tsx scripts/process-emails.ts",
    "proofs:purge": "tsx scripts/purge-proofs.ts",
    "e2e:prepare": "prisma migrate reset --force --skip-seed --skip-generate && tsx prisma/seed.ts && tsx scripts/seed-e2e.ts",
    "shipping:apply": "tsx scripts/apply-shipping-rates.ts",
    "stock:min": "tsx scripts/set-min-stock.ts",
    "catalogue:snapshot": "tsx scripts/export-catalogue-snapshot.ts",
    "catalogue:install": "tsx scripts/import-catalogue-snapshot.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.689.0",
    "@glaciora/shared": "0.1.0",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.5.6",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "qrcode": "1.5.4",
    "sharp": "0.33.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
