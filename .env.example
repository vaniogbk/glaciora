# =====================================================================
# GLACIORA — variables d'environnement (exemple SANS valeurs réelles)
# Copier vers apps/api/.env et apps/web/.env.local en développement.
# En préproduction / production : saisir les valeurs dans Railway (API) et Vercel (web).
# Ne jamais committer de fichier .env.
# =====================================================================

# ---------- API (apps/api — Railway) ----------
NODE_ENV=production                 # development | test | production
APP_ENV=production                  # development | test | staging | production
PORT=4000                           # Railway injecte PORT automatiquement
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB   # Railway : ${{Postgres.DATABASE_URL}}

# Origines autorisées pour les requêtes qui modifient des données (séparées par des virgules)
WEB_ORIGIN=https://glaciora-chi.vercel.app
PUBLIC_SITE_URL=https://glaciora-chi.vercel.app
# Nombre de proxys de confiance (Vercel + Railway = 2)
TRUST_PROXY=2

# Secrets JWT : 32 caractères minimum, différents, générés aléatoirement
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Compte bancaire principal (affiché aux pays sans compte dédié dans Admin > Coordonnées bancaires)
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# E-mails transactionnels
ORDER_NOTIFICATION_EMAIL=glacioara@outlook.fr
EMAIL_PROVIDER=brevo                # console (dev : journalise sans envoyer) | brevo
BREVO_API_KEY=
EMAIL_FROM=                         # expéditeur validé dans Brevo (ex. commandes@votre-domaine)
EMAIL_FROM_NAME=GLACIORA
EMAIL_MAX_ATTEMPTS=6
EMAIL_WORKER_INTERVAL_MS=30000

# Stockage privé des justificatifs de virement
STORAGE_DRIVER=r2                   # local (dev) | r2 (Cloudflare R2)
STORAGE_LOCAL_DIR=./storage/private
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_MAX_BYTES=10485760           # 10 Mo
PROOF_RETENTION_DAYS=400            # suppression automatique (npm run proofs:purge -w @glaciora/api)

# Import du catalogue (poste qui contient le dossier client)
CATALOGUE_DIR=../../GLACIORA_CATALOGUE
PRODUCT_MEDIA_DIR=../web/public/media
PRODUCT_MEDIA_BASE_URL=/media

# Seed (npm run db:seed) : compte admin initial, à créer une seule fois puis à retirer
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO_SHIPPING=false            # true = tarifs [DÉMO] (développement / tests uniquement)

# ---------- Web (apps/web — Vercel) ----------
API_URL=https://VOTRE-API.up.railway.app      # URL publique Railway de l'API (utilisée par le proxy /api)
NEXT_PUBLIC_SITE_URL=https://glaciora-chi.vercel.app
